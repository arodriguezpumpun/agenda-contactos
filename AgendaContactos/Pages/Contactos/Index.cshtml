@page
@model AgendaContactos.Pages.Contactos.IndexModel
@{
    ViewData["Title"] = "Contactos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    
    <h1>
        Contactos
        @if (Model.ContactosFiltrados == Model.TotalContactos)
        {
            <span class="badge bg-secondary">@Model.TotalContactos</span>
        }
        else
        {
            <span class="badge bg-secondary">@Model.ContactosFiltrados de @Model.TotalContactos</span>
        }
    </h1>

    <div>
        <a asp-page="Index" asp-route-soloFavoritos="false"
           class="btn btn-outline-warning @(Model.SoloFavoritos ? "" : "active")">
            <i class="bi bi-people"></i> Todos
        </a>
        <a asp-page="Index" asp-route-soloFavoritos="true"
           class="btn btn-outline-warning @(Model.SoloFavoritos ? "active" : "")">
            <i class="bi bi-star-fill"></i> Solo favoritos
        </a>
        <a asp-page="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo contacto
        </a>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    
    <form method="get" class="row g-2" id="searchForm">
        <div class="col-auto">
            <div class="input-group input-group-sm">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <div class="position-relative">
                    <input asp-for="Busqueda" class="form-control pe-5" id="searchInput" placeholder="Búsqueda por nombre o apellidos" style="min-width: 250px;" />
                    <button type="button" id="clearSearch" 
                            class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-decoration-none text-muted pe-2"
                            style="display: none;">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
    </form>

    <div>
        <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#importarCsvModal">
            <i class="bi bi-upload"></i> Importar CSV
        </button>
        <a asp-page="Index" asp-page-handler="ExportarCsv" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-download"></i> Exportar CSV
        </a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-@(TempData["MensajeTipo"] ?? "success")">
        @mensaje
    </div>
}

@if (!Model.Contactos.Any())
{
    <p class="text-muted">Todavía no hay contactos.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 60px;"></th>
                <th>
                    <a href="/Contactos?orden=nombre&direccion=@(Model.Orden == "nombre" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos"
                       class="text-white text-decoration-none">
                        Nombre
                        @if (Model.Orden == "nombre")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th>
                    <a href="/Contactos?orden=apellidos&direccion=@(Model.Orden == "apellidos" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos"
                       class="text-white text-decoration-none">
                        Apellidos
                        @if (Model.Orden == "apellidos")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th>
                    <a href="/Contactos?orden=apodo&direccion=@(Model.Orden == "apodo" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos"
                       class="text-white text-decoration-none">
                        Apodo
                        @if (Model.Orden == "apodo")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th>Teléfono</th>
                <th>Email</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contacto in Model.Contactos)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(contacto.FotoUrl))
                        {
                            <img src="@contacto.FotoUrl" alt="@contacto.Nombre" class="rounded-circle"
                                 style="width: 40px; height: 40px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                 style="width: 40px; height: 40px; font-weight: bold;">
                                @contacto.Nombre.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </td>
                    <td>@contacto.Nombre</td>
                    <td>@contacto.Apellidos</td>
                    <td>@contacto.Apodo</td>
                    <td>@contacto.Telefono</td>
                    <td>@contacto.Email</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="ToggleFavorito" asp-route-id="@contacto.Id" class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm @(contacto.Favorito ? "btn-warning" : "btn-outline-warning")"
                                    title="@(contacto.Favorito ? "Quitar de favoritos" : "Añadir a favoritos")">
                                <i class="bi @(contacto.Favorito ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                        </form>
                        <a asp-page="Editar" asp-route-id="@contacto.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                data-bs-toggle="modal" 
                                data-bs-target="#borrarModal"
                                data-contacto-id="@contacto.Id"
                                data-contacto-nombre="@contacto.Nombre @contacto.Apellidos">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   href="/Contactos?pageNumber=@(Model.CurrentPage - 1)&busqueda=@Model.Busqueda&orden=@Model.Orden&direccion=@Model.Direccion&soloFavoritos=@Model.SoloFavoritos">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       href="/Contactos?pageNumber=@i&busqueda=@Model.Busqueda&orden=@Model.Orden&direccion=@Model.Direccion&soloFavoritos=@Model.SoloFavoritos">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   href="/Contactos?pageNumber=@(Model.CurrentPage + 1)&busqueda=@Model.Busqueda&orden=@Model.Orden&direccion=@Model.Direccion&soloFavoritos=@Model.SoloFavoritos">Siguiente</a>
            </li>
        </ul>
    </nav>
}

<div class="modal fade" id="importarCsvModal" tabindex="-1" aria-labelledby="importarCsvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="ImportarCsv" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="importarCsvModalLabel">
                        <i class="bi bi-upload"></i> Importar contactos desde CSV
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Selecciona un archivo CSV con el siguiente formato:</p>
                    <pre class="bg-light p-2 rounded"><code>Nombre,Apellidos,Apodo,Telefono,Email,Favorito
Ana,García,La Jefa,600111222,ana@ejemplo.com,Sí</code></pre>
                    <div class="mb-3">
                        <label for="CsvFile" class="form-label">Archivo CSV</label>
                        <input type="file" name="CsvFile" id="CsvFile" class="form-control" accept=".csv" required />
                    </div>
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> El CSV debe tener las columnas: <strong>Nombre, Apellidos,
                        Apodo, Telefono, Email, Favorito</strong>.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-info">
                        <i class="bi bi-upload"></i> Importar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="borrarModal" tabindex="-1" aria-labelledby="borrarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="borrarModalLabel">
                    <i class="bi bi-exclamation-triangle text-warning"></i> Confirmar borrado
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que quieres borrar a <strong id="nombreContacto"></strong>?
                <br />
                <small class="text-muted">Esta acción no se puede deshacer.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <form method="post" asp-page-handler="Borrar" id="borrarForm" class="d-inline">
                    <input type="hidden" name="id" id="borrarContactoId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Sí, borrar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('searchForm');
        const input = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearSearch');
        let timeout = null;

        function toggleClearButton() {
            clearBtn.style.display = input.value.trim().length > 0 ? 'block' : 'none';
        }

        toggleClearButton();
        input.addEventListener('input', toggleClearButton);

        if (input.value.trim().length > 0) {
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);
        }

        input.addEventListener('input', function () {
            clearTimeout(timeout);
            timeout = setTimeout(function () {
                form.submit();
            }, 500);
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                clearTimeout(timeout);
                form.submit();
            }
        });

        // Limpiar al pulsar la X
        clearBtn.addEventListener('click', function () {
            input.value = '';
            clearTimeout(timeout);
            form.submit();
        });
    })();
</script>

<script>
    (function () {
        const borrarModal = document.getElementById('borrarModal');
        
        borrarModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            
            const contactoId = button.getAttribute('data-contacto-id');
            const contactoNombre = button.getAttribute('data-contacto-nombre');
            
            document.getElementById('borrarContactoId').value = contactoId;
            document.getElementById('nombreContacto').textContent = contactoNombre;
        });
    })();
</script>