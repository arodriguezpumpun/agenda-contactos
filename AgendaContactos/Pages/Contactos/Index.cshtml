@page
@model AgendaContactos.Pages.Contactos.IndexModel
@{
    ViewData["Title"] = "Contactos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>
        Contactos
        @if (Model.ContactosFiltrados == Model.TotalContactos)
        {
            <span class="badge bg-secondary">@Model.TotalContactos</span>
        }
        else
        {
            <span class="badge bg-secondary">@Model.ContactosFiltrados / @Model.TotalContactos</span>
        }
    </h1>

    <div>
        <a asp-page="Index" asp-route-soloFavoritos="false"
           class="btn btn-outline-secondary me-1 @(Model.SoloFavoritos ? "" : "active")">
            <i class="bi bi-people"></i> Todos
        </a>
        <a asp-page="Index" asp-route-soloFavoritos="true"
           class="btn btn-outline-secondary me-1 @(Model.SoloFavoritos ? "active" : "")">
            <i class="bi bi-star-fill"></i> Solo favoritos
        </a>
        <a asp-page="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo contacto
        </a>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2 align-items-center" id="searchForm" hx-get="/Contactos?handler=Tabla"
          hx-target="#tablaContactos" hx-swap="innerHTML"
          hx-trigger="submit, change from:select, input delay:500ms from:#searchInput"
          hx-include="[name='Busqueda'], [name='CategoriaFiltro']" hx-push-url="true">
    
        <div class="input-group input-group-sm">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <div class="position-relative">
                <input asp-for="Busqueda" class="form-control" id="searchInput"
                       placeholder="Búsqueda por nombre o apellidos" style="min-width: 270px;" />
                <button type="button" id="clearSearch"
                        class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-decoration-none text-muted pe-2"
                        style="display: none;">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>

        <select asp-for="CategoriaFiltro" class="form-select form-select-sm" style="width: auto;">
            <option value="">Todas las categorías</option>
            <option value="Familia">Familia</option>
            <option value="Amigos">Amigos</option>
            <option value="Trabajo">Trabajo</option>
            <option value="Cliente">Cliente</option>
            <option value="Otro">Otro</option>
        </select>
    </form>

    <div>
        <button type="button" class="btn btn-sm btn-secondary me-1" data-bs-toggle="modal"
                data-bs-target="#importarCsvModal">
            <i class="bi bi-upload"></i> Importar CSV
        </button>
        <a asp-page="Index" asp-page-handler="ExportarCsv" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-download"></i> Exportar CSV
        </a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-@(TempData["MensajeTipo"] ?? "success")">
        @mensaje
    </div>
}

<div id="spinner">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<div id="tablaContactos">
    <partial name="_TablaContactos" model="Model" />
</div>

<div class="modal fade" id="importarCsvModal" tabindex="-1" aria-labelledby="importarCsvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="ImportarCsv" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="importarCsvModalLabel">
                        <i class="bi bi-upload"></i> Importar contactos desde CSV
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Selecciona un archivo CSV con el siguiente formato:</p>
                    <pre class="bg-light p-2 rounded"><code>Nombre,Apellidos,Apodo,Telefono,Email,Notas,Favorito
Ana,García,La Jefa,600111222,ana@ejemplo.com,Nota 1,Sí</code></pre>
                    <div class="mb-3">
                        <label for="CsvFile" class="form-label">Archivo CSV</label>
                        <input type="file" name="CsvFile" id="CsvFile" class="form-control" accept=".csv" required />
                    </div>
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> El CSV debe tener las columnas: <strong>Nombre, Apellidos,
                        Apodo, Telefono, Email, Notas,Favorito</strong>.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-info">
                        <i class="bi bi-upload"></i> Importar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="borrarModal" tabindex="-1" aria-labelledby="borrarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="borrarModalLabel">
                    <i class="bi bi-exclamation-triangle text-warning"></i> Confirmar borrado
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que quieres borrar a <strong id="nombreContacto"></strong>?
                <br />
                <small class="text-muted">Esta acción no se puede deshacer.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <form method="post" asp-page-handler="Borrar" id="borrarForm" class="d-inline">
                    <input type="hidden" name="id" id="borrarContactoId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Sí, borrar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('searchForm');
        const input = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearSearch');
        
        if (!input || !clearBtn) return;

        function toggleClearButton() {
            clearBtn.style.display = input.value.trim().length > 0 ? 'block' : 'none';
        }

        toggleClearButton();
        input.addEventListener('input', toggleClearButton);

        if (input.value.trim().length > 0) {
            input.focus();
            input.setSelectionRange(input.value.length, input.value.length);
        }

        clearBtn.addEventListener('click', function () {
            input.value = '';
            toggleClearButton();
            htmx.trigger(form, 'submit');
        });
    })();
</script>

<script>
    (function () {
        const borrarModal = document.getElementById('borrarModal');
        
        borrarModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            
            const contactoId = button.getAttribute('data-contacto-id');
            const contactoNombre = button.getAttribute('data-contacto-nombre');
            
            document.getElementById('borrarContactoId').value = contactoId;
            document.getElementById('nombreContacto').textContent = contactoNombre;
        });
    })();
</script>

<script>
    document.body.addEventListener('htmx:afterSwap', function (evt) {
        const tabla = document.getElementById('tablaContactos');
        
        if (tabla) {
            tabla.classList.remove('tabla-animada');
            
            void tabla.offsetWidth;
            
            tabla.classList.add('tabla-animada');
        }
    });
</script>