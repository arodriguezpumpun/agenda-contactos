@page
@model AgendaContactos.Pages.Contactos.IndexModel
@{
    ViewData["Title"] = "Contactos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Contactos</h1>
    <a asp-page="Crear" class="btn btn-primary">+ Nuevo contacto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input asp-for="Busqueda" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-page="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!Model.Contactos.Any())
{
    <p class="text-muted">Todavía no hay contactos.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contacto in Model.Contactos)
            {
                <tr>
                    <td>@contacto.Nombre</td>
                    <td>@contacto.Telefono</td>
                    <td>@contacto.Email</td>
                    <td class="text-end">
                        <a asp-page="Editar" asp-route-id="@contacto.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form method="post" asp-page-handler="Borrar" asp-route-id="@contacto.Id" class="d-inline" onsubmit="return confirm('¿Borrar a @contacto.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Borrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- ⬇️ PAGINACIÓN (usa pageNumber, no page) ⬇️ -->
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="/Contactos?pageNumber=@(Model.CurrentPage - 1)&busqueda=@Model.Busqueda">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="/Contactos?pageNumber=@i&busqueda=@Model.Busqueda">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" href="/Contactos?pageNumber=@(Model.CurrentPage + 1)&busqueda=@Model.Busqueda">Siguiente</a>
            </li>
        </ul>
    </nav>
}