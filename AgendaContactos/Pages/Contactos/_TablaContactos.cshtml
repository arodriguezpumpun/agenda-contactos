@model AgendaContactos.Pages.Contactos.IndexModel

@if (!Model.Contactos.Any())
{
    <p class="text-muted">Todavía no hay contactos.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 60px;"></th>
                <th style="width: 10%;">
                    <a hx-get="/Contactos?handler=Tabla&orden=nombre&direccion=@(Model.Orden == "nombre" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                       hx-target="#tablaContactos" hx-swap="innerHTML" hx-push-url="true"
                       class="text-white text-decoration-none" style="cursor: pointer;">
                        Nombre
                        @if (Model.Orden == "nombre")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th style="width: 14%;">
                    <a hx-get="/Contactos?handler=Tabla&orden=apellidos&direccion=@(Model.Orden == "apellidos" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                       hx-target="#tablaContactos" hx-swap="innerHTML" hx-push-url="true"
                       class="text-white text-decoration-none" style="cursor: pointer;">
                        Apellidos
                        @if (Model.Orden == "apellidos")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th style="width: 12%;">
                    <a hx-get="/Contactos?handler=Tabla&orden=apodo&direccion=@(Model.Orden == "apodo" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                       hx-target="#tablaContactos" hx-swap="innerHTML" hx-indicator="#spinner" hx-push-url="true"
                       class="text-white text-decoration-none" style="cursor: pointer;">
                        Apodo
                        @if (Model.Orden == "apodo")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th style="width: 10%;">
                    <a hx-get="/Contactos?handler=Tabla&orden=categoria&direccion=@(Model.Orden == "categoria" && Model.Direccion == "asc" ? "desc" : "asc")&busqueda=@Model.Busqueda&pageNumber=@Model.CurrentPage&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                       hx-target="#tablaContactos" hx-swap="innerHTML" hx-push-url="true"
                       class="text-white text-decoration-none" style="cursor: pointer;">
                        Categoría
                        @if (Model.Orden == "categoria")
                        {
                            <i class="bi @(Model.Direccion == "asc" ? "bi-sort-up" : "bi-sort-down")"></i>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-up"></i>
                        }
                    </a>
                </th>
                <th style="width: 12%;">Teléfono</th>
                <th style="width: 18%;">Email</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contacto in Model.Contactos)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(contacto.FotoUrl))
                        {
                            <img src="@contacto.FotoUrl" alt="@contacto.Nombre" class="rounded-circle"
                                 style="width: 40px; height: 40px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                 style="width: 40px; height: 40px; font-weight: bold;">
                                @contacto.Nombre.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </td>
                    <td>@contacto.Nombre</td>
                    <td>@contacto.Apellidos</td>
                    <td>@contacto.Apodo</td>
                    <td>
                        @if (!string.IsNullOrEmpty(contacto.Categoria))
                        {
                            <span class="badge bg-secondary">@contacto.Categoria</span>
                        }
                    </td>
                    <td>@contacto.Telefono</td>
                    <td>@contacto.Email</td>
                    <td class="text-end">
                        <a asp-page="Detalles" asp-route-id="@contacto.Id" class="btn btn-sm btn-outline">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        <form method="post" asp-page-handler="ToggleFavorito" asp-route-id="@contacto.Id" class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm @(contacto.Favorito ? "btn-warning" : "btn-outline-warning")"
                                    title="@(contacto.Favorito ? "Quitar de favoritos" : "Añadir a favoritos")">
                                <i class="bi @(contacto.Favorito ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                        </form>
                        <a asp-page="Editar" asp-route-id="@contacto.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                data-bs-target="#borrarModal" data-contacto-id="@contacto.Id"
                                data-contacto-nombre="@contacto.Nombre @contacto.Apellidos">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" style="cursor: pointer;"
                   hx-get="/Contactos?handler=Tabla&pageNumber=@(Model.CurrentPage - 1)&busqueda=@Model.Busqueda&orden=@Model.Orden&direccion=@Model.Direccion&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                   hx-target="#tablaContactos" hx-swap="innerHTML" hx-push-url="true">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" style="cursor: pointer;"
                       hx-get="/Contactos?handler=Tabla&pageNumber=@i&busqueda=@Model.Busqueda&orden=@Model.Orden&direccion=@Model.Direccion&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                       hx-target="#tablaContactos" hx-swap="innerHTML" hx-push-url="true">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" style="cursor: pointer;"
                   hx-get="/Contactos?handler=Tabla&pageNumber=@(Model.CurrentPage + 1)&busqueda=@Model.Busqueda&orden=@Model.Orden&direccion=@Model.Direccion&soloFavoritos=@Model.SoloFavoritos&categoriaFiltro=@Model.CategoriaFiltro"
                   hx-target="#tablaContactos" hx-swap="innerHTML" hx-push-url="true">Siguiente</a>
            </li>
        </ul>
    </nav>
}